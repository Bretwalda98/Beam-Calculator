[
  {
    "id": "hea200a_class2_plastic_ltb_udl",
    "title": "HE 200 A Class 1-2 plastic bending with LTB and UDL",
    "auditPurpose": "Baseline plastic section resistance, shear resistance, LTB, support reaction and SLS deflection selection.",
    "input": {
      "section": { "family": "HEA", "name": "HE 200 A" },
      "material": { "grade": "S355" },
      "units": "tonne",
      "model": { "span": 6, "supportType": "ss", "includeSelfWeight": true },
      "combination": { "combination": "en1990_610", "psiQ1": 0.7, "psiQ2": 0.7 },
      "settings": {
        "sectionClass": 2,
        "gammaM0": 1,
        "gammaM1": 1,
        "deflectionLimit": 300,
        "enableLTB": true,
        "ltbRestraints": 0,
        "ltbK": 1,
        "ltbC1": 1,
        "ltbC2": 0,
        "ltbModel": "rolled",
        "bucklingKy": 1,
        "bucklingKz": 1,
        "bucklingCurveY": "auto",
        "bucklingCurveZ": "auto",
        "kyy": 1,
        "kzy": 0.6
      },
      "loads": { "udls": [{ "label": "G UDL", "x1": 0, "x2": 6, "G": 2, "Q1": 0, "Q2": 0 }], "points": [] },
      "axial": { "G": 0, "Q1": 0, "Q2": 0 }
    },
    "expected": {
      "status": "FAIL",
      "sectionModulusLabel": "Wpl,y",
      "summary": { "governingIR": 2.18033, "maxMoment": 12.40697, "maxShear": 8.27131, "deflection": 43.60651 },
      "checks": {
        "moment": { "ir": 0.79844, "pass": true, "label": "My,Rd" },
        "shear": { "ir": 0.21897, "pass": true },
        "deflection": { "ir": 2.18033, "pass": false },
        "ltb": { "ir": 0.83165, "pass": true, "available": true },
        "memberBuckling": { "active": false }
      },
      "controlHeadings": ["SECTION CONTROL:", "BUCKLING CONTROL: (incl Lateral Torsional Buckling)", "DEFLECTION CONTROL: (L/300)"]
    },
    "auditNotes": "Current branch uses Wpl,y for Class 1-2 and applies LTB. Colbeam parity depends on matching Mcr/C-factor assumptions."
  },
