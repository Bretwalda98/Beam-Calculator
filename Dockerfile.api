# syntax=docker/dockerfile:1.7
FROM node:22.17.0-bookworm-slim

ARG AWS_RDS_GLOBAL_BUNDLE_SHA256=e5bb2084ccf45087bda1c9bffdea0eb15ee67f0b91646106e466714f9de3c7e3
ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
  && curl --fail --location --silent --show-error \
    https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
    --output /etc/ssl/certs/aws-rds-global-bundle.pem \
  && echo "${AWS_RDS_GLOBAL_BUNDLE_SHA256}  /etc/ssl/certs/aws-rds-global-bundle.pem" | sha256sum --check --strict \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
  && npm cache clean --force

COPY backend ./backend
COPY scripts/migrate-database.js ./scripts/migrate-database.js
COPY server.js ./

USER node
EXPOSE 8080
CMD ["npm", "start"]
